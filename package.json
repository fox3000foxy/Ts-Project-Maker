{
  "name": "ts-project-maker",
  "version": "1.0.0",
  "description": "A typescript project template with express, inversify, and other useful libraries.",
  "main": "src/index.ts",
  "scripts": {
    "start": "npx node dist/index.js",
    "lint": "npx eslint src --ext .ts",
    "lint:fix": "npx eslint src --ext .ts --fix",
    "format": "npx prettier --write src",
    "format:check": "npx prettier --check src",
    "dev": "npx ts-node-dev src/index.ts",
    "build": "npx tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --detectOpenHandles --forceExit",
    "test-watch": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --watch --detectOpenHandles  --forceExit"
  },
  "bin": {
    "ts-project-maker": "./dist/cli/ts-project-maker.js"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/express": "^5.0.1",
    "@types/node": "^14.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/yup": "^0.32.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-node": "^10.0.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.30.1"
  },
  "author": "fox3000foxy",
  "license": "MIT"
}
